Version 4.1
SHEET 1 760 360
WIRE 80 80 160 80
WIRE 240 80 240 96
WIRE 240 160 80 160
FLAG 80 160 0
FLAG 80 80 in
FLAG 240 80 out
SYMBOL voltage 80 64 R0
SYMATTR InstName V1
SYMATTR Value PULSE(0 5 0 1n 1n 25u 50u)
SYMBOL res 144 96 R270
SYMATTR InstName R1
SYMATTR Value {Rs}
SYMBOL cap 224 96 R0
SYMATTR InstName C1
SYMATTR Value 1n
TEXT 80 24 Left 2 ;Experiment 1: link LED + photodiode as RC low-pass (series resistor Rs, capacitance C)
TEXT 80 208 Left 2 !.param Rs=2k
TEXT 80 240 Left 2 !.step param Rs list 1k 2.2k 4.7k
TEXT 80 272 Left 2 !.tran 0 100u
TEXT 80 304 Left 2 !.meas tran trise TRIG V(out)=0.5 RISE=2 TARG V(out)=4.5 RISE=2
TEXT 80 336 Left 2 !.meas tran fgr PARAM 0.35/trise
