Version 4.1
SHEET 1 800 400
FLAG 80 176 0
FLAG 80 96 in
FLAG 240 176 0
FLAG 240 96 P
SYMBOL voltage 80 80 R0
SYMATTR InstName V1
SYMATTR Value 0
SYMBOL bv 240 80 R0
SYMATTR InstName B1
SYMATTR Value V=u(V(in)-{Ith})*{eta}*(V(in)-{Ith})
TEXT 80 24 Left 2 ;Experiment 5: laser diode P-I curve (behavioural model): V(in) = current in mA, V(P) = output power in mW
TEXT 80 224 Left 2 !.param T=20 T0=100 Ith0=16.37
TEXT 80 256 Left 2 !.param Ith={Ith0*exp(T/T0)}
TEXT 80 288 Left 2 !.param eta={0.66*(1-0.012*(T-20))}
TEXT 80 320 Left 2 !.step param T list 20 30 40
TEXT 80 352 Left 2 !.dc V1 0 40 0.1
